# =============================================================================
# AI StudyMate - Backend Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# --- Database (Supabase PostgreSQL) ---
# Get this from Supabase Dashboard > Settings > Database > Connection string
DATABASE_URL=postgresql://postgres:[PASSWORD]@[PROJECT-REF].supabase.co:5432/postgres

# --- Supabase Storage (optional — enables cloud file storage) ---
# Get from Supabase Dashboard > Settings > API
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET=documents

# --- LLM Provider (with automatic fallback chain) ---
# Primary provider: groq, gemini, or ollama
LLM_PROVIDER=groq

# Groq (free tier: 100k tokens/day) - https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# Google Gemini (free tier: generous limits) - https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Ollama (local, unlimited) - https://ollama.ai
# Install Ollama locally and run: ollama pull llama3.2
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=llama3.2

# Optional: OpenAI fallback - https://platform.openai.com
OPENAI_API_KEY=your-openai-key-here

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-super-secret-jwt-key-minimum-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Vector Database ---
VECTOR_DB_PATH=./data/chromadb

# --- File Storage ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800

# --- Voice Services ---
# Speechmatics (8 hours free/month) - https://portal.speechmatics.com
SPEECHMATICS_API_KEY=your-speechmatics-api-key
STT_PROVIDER=speechmatics

# --- Application ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ENVIRONMENT=development
LOG_LEVEL=INFO
